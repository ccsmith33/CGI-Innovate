# ============================================================
# Project Sentinel — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here

# --- PostgreSQL (local Docker) ---
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Database URL (used by FastAPI backend) ---
# Local Docker: uses service name "db" as host
DATABASE_URL=postgresql+asyncpg://sentinel:change-me-in-production@db:5432/sentinel

# --- Frontend ---
# Local development: point at the backend container
NEXT_PUBLIC_API_URL=http://localhost:8000
# DigitalOcean Droplet: change to your Droplet's public IP
# NEXT_PUBLIC_API_URL=http://YOUR_DROPLET_IP:8000
