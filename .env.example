# ============================================================
# Project Sentinel — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here

# --- PostgreSQL (local Docker) ---
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Database URL (used by FastAPI backend) ---
# Local Docker: uses service name "db" as host
DATABASE_URL=postgresql+asyncpg://sentinel:change-me-in-production@db:5432/sentinel

# --- Frontend ---
# Local: point at the backend container
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- DigitalOcean (production overrides) ---
# DATABASE_URL is injected automatically by DO App Platform via ${db.DATABASE_URL}
# OPENAI_API_KEY must be added as a SECRET in the DO App Platform console
# NEXT_PUBLIC_API_URL is set to ${backend.PUBLIC_URL} at build time
